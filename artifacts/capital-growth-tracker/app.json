{
  "expo": {
    "name": "CapGrow",
    "slug": "capgrow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "capgrow",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#F7F4EF",
      "resizeMode": "contain",
      "image": "./assets/images/icon.png"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.capgrow.app"
    },
    "android": {
      "package": "com.capgrow.app"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}